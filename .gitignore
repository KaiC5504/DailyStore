# Xcode / SwiftPM
.build/
DerivedData/
*.xcodeproj/
xcuserdata/
.swiftpm/

# Python
.venv/
__pycache__/

# Local secrets - never commit Riot cookies or credentials
*.cookies
.env

# Signing secrets. Never committed, not even temporarily. Codemagic holds the signing
# key and the App Store Connect key; nothing in this repo needs either.
.env.*
*token*.txt
*.p8
*.p12
*.pem
*.mobileprovision

# Generated by XcodeGen from ios/project.yml on the build machine.
*.xcworkspace
ios/Generated/
build/
*.xcuserstate

.DS_Store
Thumbs.db
